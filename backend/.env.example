# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=5000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/opsrecall?retryWrites=true&w=majority

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Cloud (https://ui.hindsight.vectorize.io -> Connect page)
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=opsrecall-incidents

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
